  "components": {
    "schemas": {
      "CreateBookingDTO": {
        "required": [
          "bookingDate",
          "endDate",
          "facilityId",
          "groupSize",
          "memberId",
          "startDate",
          "status"
        ],
        "type": "object",
        "properties": {
          "bookingDate": {
            "type": "string",
            "format": "date-time"
          },
          "startDate": {
            "type": "string",
            "format": "date-span"
          },
          "endDate": {
            "type": "string",
            "format": "date-span"
          },
          "groupSize": {
            "maximum": 100,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "minLength": 1,
            "type": "string"
          },
          "memberId": {
            "type": "integer",
            "format": "int32"
          },
          "facilityId": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "CreateFacilityDTO": {
        "required": [
          "capacity",
          "hourePrice",
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "capacity": {
            "maximum": 100,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "hourePrice": {
            "maximum": 10000,
            "minimum": 50,
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "CreateMemberDTO": {
        "required": [
          "dob",
          "email",
          "fullName",
          "phone"
        ],
        "type": "object",
        "properties": {
          "fullName": {
            "maxLength": 100,
            "minLength": 3,
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "phone": {
            "minLength": 1,
            "type": "string",
            "format": "tel"
          },
          "dob": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "CreateMemberShipDTO": {
        "required": [
          "memberId",
          "price",
          "startDate",
          "status",
          "type"
        ],
        "type": "object",
        "properties": {
          "type": {
            "minLength": 1,
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "format": "date-time"
          },
          "endDate": {
            "type": "string",
            "format": "date-time"
          },
          "price": {
            "maximum": 1000,
            "minimum": 100,
            "type": "number",
            "format": "double"
          },
          "status": {
            "minLength": 1,
            "type": "string"
          },
          "memberId": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "CreatePaymentDTO": {
        "required": [
          "amount",
          "membershipId",
          "paymentDate",
          "paymentMethod"
        ],
        "type": "object",
        "properties": {
          "amount": {
            "maximum": 10000,
            "minimum": 100,
            "type": "number",
            "format": "double"
          },
          "paymentDate": {
            "type": "string",
            "format": "date-time"
          },
          "paymentMethod": {
            "minLength": 1,
            "type": "string"
          },
          "membershipId": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "WeatherForecast": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "temperatureC": {
            "type": "integer",
            "format": "int32"
          },
          "temperatureF": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          },
          "summary": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
